# Copy to .env.deploy (git-ignored), fill in, then: chmod 600 .env.deploy
# Used by: set -a; . ./.env.deploy; set +a; ./deploy.sh   (and ./deploy_deleteme.sh)
CE_PROJECT=rst-ce-demo
IMAGE=private.ca.icr.io/rst-icr-ca/weekly-cleanup:v8
REGISTRY_SECRET=ca-rst-icr-key
IBMCLOUD_API_KEY=

# deleteme cleanup job (deploy_deleteme.sh). Create the review bucket, its HMAC
# credential and Code Engine HMAC secret, the service ID + API key, and the COS
# Notifications Manager authorization by hand first.
DELETEME_API_KEY=
REVIEW_BUCKET=
REVIEW_HMAC_SECRET=
# Comma-separated extra CRNs never to delete (e.g. the review bucket's COS instance)
PROTECTED_CRNS=
# Only "false" deploys the job live
DELETEME_DRY_RUN=true
