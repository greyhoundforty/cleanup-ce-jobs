#!/usr/bin/env python3
"""Fake ibmcloud for tests: answers from $STUB_FIXTURE and records argv to $STUB_CALLS."""

import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["STUB_CALLS"], "a") as f:
    f.write(json.dumps(argv) + "\n")

fixture_path = os.environ["STUB_FIXTURE"]
state_path = fixture_path + ".state"
entries = json.load(open(fixture_path)) if os.path.exists(fixture_path) else []
state = json.load(open(state_path)) if os.path.exists(state_path) else {}

joined = " ".join(argv)
for i, entry in enumerate(entries):
    if joined.startswith(entry["match"]):
        responses = entry["responses"]
        n = state.get(str(i), 0)
        resp = responses[min(n, len(responses) - 1)]
        state[str(i)] = n + 1
        json.dump(state, open(state_path, "w"))
        out = resp.get("stdout", "")
        sys.stdout.write(out if isinstance(out, str) else json.dumps(out))
        sys.stderr.write(resp.get("stderr", ""))
        sys.exit(resp.get("rc", 0))
sys.exit(0)
